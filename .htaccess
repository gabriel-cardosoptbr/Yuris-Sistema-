# =============================================================================
# .htaccess raiz — proteção e roteamento (Yuris)
# Adicionado em 2026-05-23 após descobrir directory listing exposto via HTTP.
# Requer Apache com mod_rewrite + AllowOverride All (já configurados no XAMPP).
# =============================================================================

# ── 1. Não listar conteúdo de diretório ─────────────────────────────────────
# Sem isto, http://localhost/sistema_vendas/ mostrava CLAUDE.md, docs/, etc.
Options -Indexes

# ── 2. Bloqueio explícito de arquivos sensíveis na raiz ─────────────────────
# Estes arquivos NUNCA devem ser servidos via web — só existem no filesystem
# para devs e CI. Resposta 403 ao tentar acessar diretamente.
<FilesMatch "(?i)^(CLAUDE|README|CHANGELOG|LICENSE|COMPOSER|TODO).*\.md$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(bat|sh|sql|log|ini|env|lock|sqlite|sqlite3|db)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^composer\.(json|lock)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── 3. Bloqueio de pastas internas (codigo-fonte, docs, infra) ──────────────
# Mesmo que individualmente os PHPs estejam protegidos, bloquear a pasta
# inteira via RedirectMatch evita listagem residual e enumeração.
# OBS: 'public/' e 'Imagens/' ficam acessíveis (necessárias para o app).
RedirectMatch 403 (?i)^/sistema_vendas/(docs|scripts|tests|vendor|node_modules|config)(/.*)?$

# ── 4. Redirect / → /public/index.php (landing institucional) ──────────────
# Antes (2026-05-23): redirecionava direto pra login.php (sem landing pública).
# Agora (2026-05-26): visitante novo cai na landing one-page do Yuris.
#   • /sistema_vendas/             → /public/index.php  (landing)
#   • /sistema_vendas/public/      → /public/index.php  (mesmo destino)
#   • Botão "Entrar" da landing aponta direto pra /public/login.php
# OBS: URL absoluta (com /sistema_vendas/ no caminho) evita que Apache resolva
# para path de filesystem em alguns ambientes.
# IMPORTANTE (descoberto em 2026-06-11): em produção o docker-php.conf dá
# AllowOverride All em /var/www/html, então este arquivo É processado lá
# (o docroot public/ fica dentro dele). As regras de redirect abaixo são
# SÓ do XAMPP — por isso a RewriteCond no DOCUMENT_ROOT: em prod o docroot
# termina em "public" e as regras não disparam (raiz responde 200 direto).
RewriteEngine On
RewriteBase /sistema_vendas/
RewriteCond %{DOCUMENT_ROOT} !public$
RewriteRule ^$            /sistema_vendas/public/index.php [L,R=302]
RewriteCond %{DOCUMENT_ROOT} !public$
RewriteRule ^public/?$    /sistema_vendas/public/index.php [L,R=302]

# 404 brandada: em produção fica no zz-yuris.conf (ErrorDocument 404 /404.php).
# NÃO declarar ErrorDocument aqui — .htaccess sobrescreveria o conf em prod
# com um caminho de XAMPP quebrado.
