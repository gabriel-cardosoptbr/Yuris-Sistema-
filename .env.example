# Arquivo de exemplo — copie pra .env e ajuste valores reais.
# O .env real NÃO entra no git (já está no .gitignore).
#
# Carregamento: config/database.php tenta ler .env primeiro e
# faz fallback pros valores hardcoded se .env não existir.

# ── Banco de dados ──
DB_HOST=127.0.0.1
DB_NAME=sistema_vendas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Cron token (interno) ──
CRON_TOKEN=yuris_cron_token_change_me

# ── Evolution API (WhatsApp) — guardar TAMBÉM no banco em whatsapp_settings ──
# Esses só são usados como fallback se whatsapp_settings estiver vazio.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# TLS verify ao chamar a Evolution API (LGPD P1 — protege contra MITM).
# Padrão: true (verifica). Defina false APENAS se Evolution tem cert
# self-signed/expirado em ambiente dev. NUNCA defina false em produção.
EVOLUTION_TLS_VERIFY=true

# ── App ──
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/sistema_vendas

# ── Billing gateway (LGPD P0 — NullGateway só roda em dev/loopback) ──
# Valores aceitos: null | stripe | mercadopago | asaas
# Em produção (APP_ENV=production) NÃO pode ser "null" (Gateway::driver lança erro).
BILLING_GATEWAY=null

# ── 2FA / MFA para super_admin (LGPD P0) ──
# Chave AES-256 (32 bytes) para cifrar mfa_secret at-rest.
# Gere com:  openssl rand -base64 32
# Formato: base64:<32-byte-base64>  OU  hex:<64-hex-chars>  OU  raw 32 bytes
# OBRIGATÓRIA se algum super_admin tiver mfa_enabled=1.
MFA_ENCRYPTION_KEY=

# ── DPO / Encarregado de Dados (LGPD Etapa 5) ──
# Exibido em /dpo.php — canal oficial para solicitações dos titulares.
# Em produção, preencha todos. Deixe vazio em dev se ainda não designado.
DPO_NAME=
DPO_EMAIL=
DPO_PHONE=
DPO_ADDRESS=

# ── Módulo Intimações (DJEN + DataJud) ──
# DJEN é a fonte primária de publicações do Diário de Justiça Eletrônico Nacional.
# Endpoint público sem auth (smoke test 2026-05-24 confirmou HTTP 200).
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# DataJud é fonte secundária pra enriquecer metadados processuais.
# Exige header Authorization: APIKey <chave>. Chave pública divulgada pelo CNJ.
# Sem chave o módulo continua funcionando, só não enriquece DataJud.
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ── Cifra at-rest de credenciais de terceiros (AES-256-GCM) ──
# Usada pelo app/Helpers/Crypto.php para cifrar:
#   • aasp_integrations.chave_encrypted (chave AASP)
#   • futuros tokens de terceiros que exigirem persistência
# Gere com:  openssl rand -base64 32
# Formatos aceitos: base64:<32-byte-base64>  OU  hex:<64-hex-chars>  OU  raw (32 bytes)
# OBRIGATÓRIA se aasp_integrations tiver qualquer linha — sem ela, encrypt()
# lança RuntimeException e o módulo AASP fica indisponível (fail-closed).
APP_ENCRYPTION_KEY=

# ── Integração AASP (Intimações) ──
# Base da API de Intimações da AASP. Cadastro de chave por associado/empresa:
#   https://intimacaoapi-cadastro.aasp.org.br/
# Swagger oficial: https://intimacaoapi.aasp.org.br/docapi/index.html
# A chave fica criptografada via APP_ENCRYPTION_KEY acima.
AASP_BASE_URL=https://intimacaoapi.aasp.org.br

# Pausa em ms entre chamadas seguidas à AASP (anti-flood / defensivo).
# AASP não declara rate limit, mas mantemos 1s pra evitar bloqueio acidental.
AASP_RATE_LIMIT_MS=1000

# Janela máxima de dias retroativos pra buscar em AASP via /search.
# Default no código: 30. Aumentar exige memória — fila DJEN pode crescer muito.
AASP_MAX_DAYS=30

# ── Mailer (e-mails transacionais) ──
# Driver usado em app/Services/Mailer.php.
# Valores aceitos:
#   log     → grava em storage/mail.log (default, dev)
#   smtp    → envia via SMTP (exige MAIL_HOST/PORT/USERNAME/PASSWORD abaixo)
#   sendmail → usa /usr/sbin/sendmail (Linux/Postfix local)
# Em produção use 'smtp' apontando pra serviço transacional (SES, Sendgrid, Postmark).
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yuris.app.br
MAIL_FROM_NAME=Yuris
