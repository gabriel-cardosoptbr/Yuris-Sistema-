# =============================================================================
# public/.htaccess — liga a camada de rota (debito D3, 08/09/2026)
#
# O DocumentRoot aponta para esta pasta, em desenvolvimento e em producao.
# Requer mod_rewrite + AllowOverride All, que ja valem nos dois lugares:
#   · producao: /etc/apache2/conf-enabled/docker-php.conf da AllowOverride All
#     em /var/www/, e rewrite_module esta carregado;
#   · local:    o vhost da porta 8090 da AllowOverride All neste diretorio.
#
# O ARQUIVO QUE EXISTE CONTINUA SENDO SERVIDO PELO APACHE, SEM PASSAR PELO PHP.
# As duas RewriteCond abaixo sao a garantia disso: so cai no front controller o
# que nao existe no disco. Por isso o raio de acao desta mudanca e exatamente
# "as URLs que hoje dariam 404", e nenhuma pagina existente muda de caminho.
# =============================================================================

# DELIBERADAMENTE SEM "Options -Indexes" AQUI.
# A diretiva Options so e aceita em .htaccess se o AllowOverride incluir Options.
# Hoje e "All" nos dois ambientes, mas se algum dia alguem apertar para
# "AllowOverride FileInfo" (que ainda permitiria o rewrite abaixo), o Apache
# passa a responder 500 em TODA requisicao desta pasta, e nao existe <IfModule>
# que proteja disso. Em producao a diretiva seria redundante: o
# /etc/apache2/conf-enabled/docker-php.conf ja da Options -Indexes em /var/www/.
# Listagem de diretorio no ambiente local se resolve no vhost local, nao aqui.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Alvo relativo (sem barra inicial): resolve para public/index.php
    # independentemente de o DocumentRoot ser public/ (porta 8090 e producao)
    # ou a raiz do repositorio (porta 80 do XAMPP).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>
