# Dependências
/vendor/
/node_modules/

# Configurações locais com credenciais
/app/Config/config.local.php
*.env
.env
.env.*
!.env.example

# Uploads e arquivos gerados (mantém o diretório versionado mas ignora conteúdo)
# .htaccess fica trackeado pra garantir proteção LGPD P0 em todos os ambientes.
/public/uploads/*
!/public/uploads/.htaccess
/storage/
# Exports LGPD de portabilidade — NUNCA versionar (dados pessoais sensíveis)
/storage/lgpd_exports/

# Logs
*.log
/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Cache
/cache/
*.cache

# Claude Code — settings per-developer (NÃO versionar)
# settings.json (team-shared) continua trackeado.
# settings.local.json contém URLs de túnel pessoal (ngrok) + allowlists locais.
/.claude/settings.local.json

# Backups locais de fases anteriores (não vão pro repo)
/.backup_*/

# arquivos locais/produção
.env
database/import.sql
database/import_clean.sql
database/import_original.sql
*.bak
*.tar.gz

# Python (scripts das skills de desenvolvimento em .claude/skills/*/scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Skills de desenvolvimento: VERSIONAR o código (SKILL.md, references/, templates/,
# scripts/, tests/, evals/) mas IGNORAR artefatos de execução/avaliação e caches.
/.claude/skills/*-workspace/
/.claude/skills/**/benchmarks/
/.claude/skills/**/*.eval-results.json
/.claude/skills/**/feedback.json
